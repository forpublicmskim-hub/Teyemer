<Window x:Class="Teyemer.App.ReminderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="눈 운동 시간" Width="410" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" Opacity="0">
 <Grid>
 <Border Margin="14" Padding="0" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18">
  <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.28" Color="#101828"/></Border.Effect>
  <Grid x:Name="GlowClipHost" SizeChanged="GlowClipHost_SizeChanged">
   <Ellipse x:Name="AmbientGlow" Width="280" Height="190" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-125,0,0" Fill="{DynamicResource AccentBrush}" Opacity="0.10" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
    <Ellipse.Effect><BlurEffect Radius="42"/></Ellipse.Effect>
    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
   </Ellipse>
   <Ellipse x:Name="HighlightGlow" Width="190" Height="130" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-95" Fill="{DynamicResource AccentBrush}" Opacity="0.07" IsHitTestVisible="False">
    <Ellipse.Effect><BlurEffect Radius="36"/></Ellipse.Effect>
    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
   </Ellipse>
   <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" Background="{DynamicResource IconBackgroundBrush}" CornerRadius="18"><TextBlock Text="◉" FontSize="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Teyemer" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="눈 운동 시간입니다" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/></StackPanel></StackPanel>
    <Button Grid.Column="1" Content="×" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" FontSize="19" Foreground="{DynamicResource SecondaryTextBrush}" Click="Close_Click"/>
   </Grid>
   <TextBlock Grid.Row="1" Text="잠시 화면에서 눈을 떼고 먼 곳을 바라보세요." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,16,0,14"/>
   <StackPanel Grid.Row="2"><TextBlock x:Name="PreviewLabel" Text="미리 보기 알림" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed"/><WrapPanel HorizontalAlignment="Right"><Button Content="건너뛰기" Click="Skip_Click"/><Button Content="5분 뒤" Click="Snooze_Click"/><Button Content="운동 시작" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click"/></WrapPanel></StackPanel>
   </Grid>
  </Grid>
 </Border>
 <Border x:Name="AnimatedBorder" Margin="14" BorderThickness="1.6" CornerRadius="18" Background="Transparent" IsHitTestVisible="False" Opacity="0.72"/>
 </Grid>
</Window>
