<Window x:Class="Teyemer.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Teyemer.App"
 Title="Teyemer - 눈 휴식 알림" Width="720" Height="620" MinWidth="640" MinHeight="520"
 WindowStartupLocation="CenterScreen" Background="Transparent"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="ThemeToggleStyle" TargetType="ToggleButton">
   <Setter Property="Width" Value="58"/><Setter Property="Height" Value="32"/>
   <Setter Property="MinWidth" Value="58"/><Setter Property="MinHeight" Value="32"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ClipToBounds" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Grid Background="Transparent" ClipToBounds="False">
     <Border x:Name="Track" Margin="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15" SnapsToDevicePixels="True">
      <Ellipse x:Name="Thumb" Width="22" Height="22" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource SecondaryTextBrush}" SnapsToDevicePixels="True">
       <Ellipse.RenderTransform><TranslateTransform x:Name="ThumbTranslate" X="0"/></Ellipse.RenderTransform>
      </Ellipse>
     </Border>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentTextBrush}"/>
      <Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="24" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.86"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Thumb" Property="Opacity" Value="0.78"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AlarmCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Border Margin="10" Padding="12" Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
   <DockPanel>
    <Grid DockPanel.Dock="Bottom" Margin="14,10,14,2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
     <Button Grid.Column="1" Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0" IsDefault="True"/>
    </Grid>
    <TabControl>
     <TabItem Header="일반">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="22,20">
        <TextBlock Text="알림" Style="{StaticResource SectionTitleStyle}"/>
        <Grid Style="{StaticResource FormRowStyle}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="알림 주기" Style="{StaticResource FormLabelStyle}"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox Width="96" Margin="0" Text="{Binding ReminderIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="분 (1~240)" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}"/>
         </StackPanel>
        </Grid>
        <Grid Style="{StaticResource FormRowStyle}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="알림 팝업" Style="{StaticResource FormLabelStyle}"/>
         <Button Grid.Column="1" Content="미리 보기" Margin="0" MinWidth="92" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding PreviewReminderCommand}" ToolTip="오른쪽 아래 알림 팝업을 즉시 표시합니다."/>
        </Grid>
        <Grid Style="{StaticResource FormRowStyle}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="자동 닫기" Style="{StaticResource FormLabelStyle}"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox Width="96" Margin="0" Text="{Binding PopupDismissSeconds, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="초 (1~60)" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}"/>
         </StackPanel>
        </Grid>
        <Grid Style="{StaticResource FormRowStyle}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="알림 소리" Style="{StaticResource FormLabelStyle}"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="재생" Margin="0,8,12,8" IsChecked="{Binding Settings.PlaySound}"/>
          <ComboBox Width="160" Margin="0,0,8,0" ItemsSource="{Binding Sounds}" SelectedItem="{Binding Settings.Sound}"/>
          <Button Content="미리 듣기" Margin="0" MinWidth="92" Command="{Binding PreviewSoundCommand}"/>
         </StackPanel>
        </Grid>
        <Separator Margin="0,18,0,16"/>
        <TextBlock Text="화면" Style="{StaticResource SectionTitleStyle}"/>
        <Grid Style="{StaticResource FormRowStyle}" MinHeight="48">
         <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="다크 모드" Style="{StaticResource FormLabelStyle}"/>
         <ToggleButton Grid.Column="1" Style="{StaticResource ThemeToggleStyle}" IsChecked="{Binding UseDarkMode, Mode=TwoWay}" ToolTip="라이트 모드와 다크 모드를 전환합니다." AutomationProperties.Name="다크 모드 전환"/>
        </Grid>
        <Separator Margin="0,18,0,16"/>
        <TextBlock Text="Windows 시작" Style="{StaticResource SectionTitleStyle}"/>
        <Grid Style="{StaticResource FormRowStyle}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="자동 실행" Style="{StaticResource FormLabelStyle}"/>
         <CheckBox Grid.Column="1" Content="PC 시작 시 실행" Margin="0,8" IsChecked="{Binding Settings.StartWithWindows}"/>
        </Grid>
        <Grid Style="{StaticResource FormRowStyle}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="시작 화면" Style="{StaticResource FormLabelStyle}"/>
         <CheckBox Grid.Column="1" Content="설정 창을 열지 않고 트레이에서 시작" Margin="0,8" IsChecked="{Binding Settings.StartMinimized}"/>
        </Grid>
        <TextBlock Text="{Binding StatusText}" Margin="150,10,0,0" Style="{StaticResource HintTextStyle}"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="활성 시간">
      <StackPanel Margin="22,20">
       <TextBlock Text="활성 시간" Style="{StaticResource SectionTitleStyle}"/>
       <TextBlock Text="매일 같은 시간대에만 알림 주기를 계산합니다. 비활성 시간의 알림은 누적하지 않습니다." Margin="0,0,0,6" Style="{StaticResource HintTextStyle}"/>
       <TextBlock Text="시작과 종료가 같으면 하루 종일, 종료가 더 이르면 자정을 넘는 시간대로 처리합니다." Margin="0,0,0,14" Style="{StaticResource HintTextStyle}"/>
       <Grid Style="{StaticResource FormRowStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="사용 여부" Style="{StaticResource FormLabelStyle}"/>
        <CheckBox Grid.Column="1" Content="활성 시간 사용" Margin="0,8" IsChecked="{Binding Settings.ActiveScheduleEnabled}"/>
       </Grid>
       <Grid Style="{StaticResource FormRowStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="시작 시간" Style="{StaticResource FormLabelStyle}"/>
        <local:TimePicker Grid.Column="1" SelectedTime="{Binding Settings.ActiveStart, Mode=TwoWay}" AutomationProperties.Name="활성 시작 시간"/>
       </Grid>
       <Grid Style="{StaticResource FormRowStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="종료 시간" Style="{StaticResource FormLabelStyle}"/>
        <local:TimePicker Grid.Column="1" SelectedTime="{Binding Settings.ActiveEnd, Mode=TwoWay}" AutomationProperties.Name="활성 종료 시간"/>
       </Grid>
      </StackPanel>
     </TabItem>
     <TabItem Header="사용자 알람">
      <Grid Margin="22,20">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="주기적인 알람 또는 매일 특정 시간 알람을 여러 개 등록할 수 있습니다." Margin="0,0,0,12" Style="{StaticResource HintTextStyle}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
         <Button Content="알람 추가" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddAlarmCommand}"/>
         <Button Content="선택 알람 설정" Style="{StaticResource ActionButtonStyle}" Command="{Binding EditAlarmCommand}"/>
         <Button Content="선택 알람 삭제" Style="{StaticResource ActionButtonStyle}" Command="{Binding DeleteAlarmCommand}"/>
        </StackPanel>
       </Grid>
       <DataGrid Grid.Row="1" ItemsSource="{Binding Settings.CustomAlarms}" SelectedItem="{Binding SelectedAlarm}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" Margin="0,12">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="사용" Width="60" IsReadOnly="False">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" ToolTip="이 알람의 사용 여부를 즉시 변경합니다." IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="AlarmEnabled_Click"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTextColumn Header="유형" Binding="{Binding TypeLabel}" Width="135" IsReadOnly="True" ElementStyle="{StaticResource AlarmCellTextStyle}"/>
         <DataGridTextColumn Header="설정" Binding="{Binding ScheduleLabel}" Width="115" IsReadOnly="True" ElementStyle="{StaticResource AlarmCellTextStyle}"/>
         <DataGridTextColumn Header="표시 문구" Binding="{Binding Content}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource AlarmCellTextStyle}"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Grid.Row="2" Text="목록에서 알람을 선택한 뒤 ‘선택 알람 설정’을 누르세요. 알람은 세션 잠금·장시간 부재 중에는 표시하지 않습니다." Margin="0,4" Style="{StaticResource HintTextStyle}"/>
      </Grid>
     </TabItem>
    </TabControl>
   </DockPanel>
  </Border>
  <Border x:Name="AnimatedWindowBorder" Margin="10" BorderThickness="1.4" CornerRadius="16" Background="Transparent" IsHitTestVisible="False" Opacity="0.42"/>
 </Grid>
</Window>
