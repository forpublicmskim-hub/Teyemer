<Window x:Class="Teyemer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Teyemer - 눈 휴식 알림" Width="720" Height="620" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}">
 <Border Background="{DynamicResource WindowBackgroundBrush}" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom" Background="{DynamicResource WindowBackgroundBrush}"><TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" Margin="8" TextWrapping="Wrap"/><Button Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" IsDefault="True"/></StackPanel>
 <TabControl>
  <TabItem Header="일반"><ScrollViewer><StackPanel Margin="18"><TextBlock Text="알림" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="눈 운동 알림 사용" IsChecked="{Binding Settings.RemindersEnabled}"/>
   <StackPanel Orientation="Horizontal"><TextBlock Text="알림 주기(분)" Width="130" VerticalAlignment="Center"/><TextBox Width="70" Text="{Binding ReminderIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/><Button Content="10" Tag="10" Click="Quick_Click"/><Button Content="20" Tag="20" Click="Quick_Click"/><Button Content="30" Tag="30" Click="Quick_Click"/><Button Content="45" Tag="45" Click="Quick_Click"/><Button Content="60" Tag="60" Click="Quick_Click"/></StackPanel>
   <StackPanel Orientation="Horizontal"><TextBlock Text="운동 시간(초)" Width="130" VerticalAlignment="Center"/><TextBox Width="100" Text="{Binding ExerciseDurationSeconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Orientation="Horizontal"><CheckBox Content="알림 팝업 표시" IsChecked="{Binding Settings.ShowPopup}"/><Button Content="알림 미리 보기" Command="{Binding PreviewReminderCommand}" ToolTip="오른쪽 아래 알림 팝업을 즉시 표시합니다."/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="자동으로 닫기(초)" Width="130" VerticalAlignment="Center"/><TextBox Width="70" Text="{Binding PopupDismissSeconds, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="1~60초" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><CheckBox Content="알림 소리 재생" IsChecked="{Binding Settings.PlaySound}"/>
   <StackPanel Orientation="Horizontal"><TextBlock Text="알림음" Width="130" VerticalAlignment="Center"/><ComboBox Width="140" ItemsSource="{Binding Sounds}" SelectedItem="{Binding Settings.Sound}"/><Button Content="미리 듣기" Command="{Binding PreviewSoundCommand}"/></StackPanel>
   <Separator Margin="0,14"/><TextBlock Text="화면" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="다크 모드" IsChecked="{Binding Settings.UseDarkMode}"/><Separator Margin="0,14"/><TextBlock Text="Windows 시작" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="PC 시작 시 자동 실행" IsChecked="{Binding Settings.StartWithWindows}"/><CheckBox Content="자동 실행 시 트레이에서 시작" IsChecked="{Binding Settings.StartMinimized}"/><TextBlock Text="{Binding StatusText}" Margin="4,16" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="활성 시간"><StackPanel Margin="18"><CheckBox Content="활성 시간 사용" IsChecked="{Binding Settings.ActiveScheduleEnabled}"/><TextBlock Text="종료가 시작보다 이르면 자정을 넘는 시간대로 처리합니다." Foreground="{DynamicResource SecondaryTextBrush}" Margin="4"/>
   <DataGrid ItemsSource="{Binding ScheduleRows}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="4,10"><DataGrid.Columns><DataGridTextColumn Header="요일" Binding="{Binding Day}" IsReadOnly="True" Width="*"/><DataGridCheckBoxColumn Header="활성" Binding="{Binding IsEnabled}" Width="90"/><DataGridTextColumn Header="시작 (HH:mm)" Binding="{Binding Start}" Width="140"/><DataGridTextColumn Header="종료 (HH:mm)" Binding="{Binding End}" Width="140"/></DataGrid.Columns></DataGrid><Button Content="월요일 시간을 평일에 적용" Command="{Binding ApplyWeekdaysCommand}" HorizontalAlignment="Left"/></StackPanel></TabItem>
  <TabItem Header="눈 운동 안내"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="눈을 위한 짧은 휴식" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="• 20분마다 약 6m 이상 떨어진 곳을 20초 동안 바라보세요.&#10;• 천천히 눈을 깜빡여 보세요.&#10;• 잠시 눈을 감고 편안하게 쉬세요.&#10;• 가까운 곳과 먼 곳을 번갈아 바라보세요.&#10;• 화면 밝기와 주변 조명이 편안한지 확인하세요.&#10;• 모니터와 적절한 거리를 유지하세요." FontSize="16" LineHeight="30" TextWrapping="Wrap"/><TextBlock Text="이 안내는 일반적인 휴식 습관을 위한 것이며 치료나 예방 효과를 보장하지 않습니다. 불편함이 지속되면 전문가와 상담하세요." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,18"/><Button Content="지금 운동하기" Command="{Binding ExerciseNowCommand}" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="정보"><StackPanel Margin="24"><TextBlock Text="Teyemer" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="가볍게 눈 휴식을 알려주는 Windows 트레이 애플리케이션" Margin="0,10"/><TextBlock Text="버전 1.0.0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></TabItem>
 </TabControl></DockPanel></Border>
</Window>
