<Window x:Class="Teyemer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Teyemer.App" Title="Teyemer - 눈 휴식 알림" Width="720" Height="620" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="ThemeToggleStyle" TargetType="ToggleButton">
   <Setter Property="Width" Value="58"/><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="58"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ClipToBounds" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent" ClipToBounds="False"><Border x:Name="Track" Margin="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15" SnapsToDevicePixels="True"><Ellipse x:Name="Thumb" Width="22" Height="22" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource SecondaryTextBrush}" SnapsToDevicePixels="True"><Ellipse.RenderTransform><TranslateTransform x:Name="ThumbTranslate" X="0"/></Ellipse.RenderTransform></Ellipse></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentTextBrush}"/><Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="24" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Thumb" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
 <Border Margin="10" Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16"><DockPanel><StackPanel DockPanel.Dock="Bottom" Background="Transparent"><TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" Margin="8" TextWrapping="Wrap"/><Button Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" IsDefault="True"/></StackPanel>
 <TabControl>
  <TabItem Header="일반"><ScrollViewer><StackPanel Margin="18"><TextBlock Text="알림" FontSize="20" FontWeight="SemiBold"/>
   <StackPanel Orientation="Horizontal"><TextBlock Text="알림 주기(분)" Width="130" VerticalAlignment="Center"/><TextBox Width="100" Text="{Binding ReminderIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="1~240분" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
   <StackPanel Orientation="Horizontal"><CheckBox Content="알림 팝업 표시" IsChecked="{Binding Settings.ShowPopup}"/><Button Content="알림 미리 보기" Command="{Binding PreviewReminderCommand}" ToolTip="오른쪽 아래 알림 팝업을 즉시 표시합니다."/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="자동으로 닫기(초)" Width="130" VerticalAlignment="Center"/><TextBox Width="70" Text="{Binding PopupDismissSeconds, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="1~60초" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><CheckBox Content="알림 소리 재생" IsChecked="{Binding Settings.PlaySound}"/>
   <StackPanel Orientation="Horizontal"><TextBlock Text="알림음" Width="130" VerticalAlignment="Center"/><ComboBox Width="140" ItemsSource="{Binding Sounds}" SelectedItem="{Binding Settings.Sound}"/><Button Content="미리 듣기" Command="{Binding PreviewSoundCommand}"/></StackPanel>
   <Separator Margin="0,14"/><TextBlock Text="화면" FontSize="20" FontWeight="SemiBold"/><Grid Margin="4,8" MinHeight="52"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="다크 모드" VerticalAlignment="Center"/><ToggleButton Grid.Column="1" Style="{StaticResource ThemeToggleStyle}" IsChecked="{Binding UseDarkMode, Mode=TwoWay}" ToolTip="라이트 모드와 다크 모드를 전환합니다." AutomationProperties.Name="다크 모드 전환"/></Grid><Separator Margin="0,14"/><TextBlock Text="Windows 시작" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="PC 시작 시 자동 실행" IsChecked="{Binding Settings.StartWithWindows}"/><CheckBox Content="자동 실행 시 트레이에서 시작" IsChecked="{Binding Settings.StartMinimized}"/><TextBlock Text="{Binding StatusText}" Margin="4,16" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="활성 시간"><StackPanel Margin="18"><CheckBox Content="활성 시간 사용" IsChecked="{Binding Settings.ActiveScheduleEnabled}"/><TextBlock Text="매일 같은 활성 시간에만 알림 주기를 계산합니다. 활성 시간 밖에서는 주기를 중단하고, 다음 활성 시간이 시작되면 새로운 전체 주기를 시작합니다." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4"/><TextBlock Text="시작과 종료가 같으면 하루 종일 활성이고, 종료가 시작보다 이르면 자정을 넘는 시간대로 처리합니다." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,0,4,14"/><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="시작 시간" VerticalAlignment="Center"/><local:TimePicker Grid.Column="1" SelectedTime="{Binding Settings.ActiveStart, Mode=TwoWay}" AutomationProperties.Name="활성 시작 시간"/></Grid><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="종료 시간" VerticalAlignment="Center"/><local:TimePicker Grid.Column="1" SelectedTime="{Binding Settings.ActiveEnd, Mode=TwoWay}" AutomationProperties.Name="활성 종료 시간"/></Grid></StackPanel></TabItem>
 </TabControl></DockPanel></Border>
 <Border x:Name="AnimatedWindowBorder" Margin="10" BorderThickness="1.4" CornerRadius="16" Background="Transparent" IsHitTestVisible="False" Opacity="0.42"/>
 </Grid>
</Window>
