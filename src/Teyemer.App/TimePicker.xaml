<UserControl x:Class="Teyemer.App.TimePicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 MinHeight="40" Focusable="False">
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
  <ComboBox x:Name="HourPicker" Width="64" MaxDropDownHeight="260"
   SelectionChanged="Picker_SelectionChanged" AutomationProperties.Name="시"/>
  <TextBlock Text=":" Margin="7,0" FontSize="18" FontWeight="SemiBold"
   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
  <ComboBox x:Name="MinutePicker" Width="64" MaxDropDownHeight="260"
   SelectionChanged="Picker_SelectionChanged" AutomationProperties.Name="분"/>
 </StackPanel>
</UserControl>
